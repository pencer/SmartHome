<html>
<body>
<meta name="viewport" content="width=device-width">
<style type="text/css">
body {
  font-family: sans-serif;
}
div.tvbtn {
  display: inline-block;
  width: 2em;
  height: 1.70em;
  text-align: center;
  vertical-align: bottom;
  background-color: navy;
  padding-top: 0.30em;
  border: medium solid dimgray;
  border-radius: 50%;
  color: white;
  font-weight: bold;
  font-size: x-large;
}
div.tvbtn.red {
  background-color: #dd0000;
  border-radius: 30%;
}
div.tvbtn.green {
  background-color: #009900;
  border-radius: 30%;
}
div.tvbtn.blue {
  background-color: #005fff;
  border-radius: 30%;
}
div.tvbtn.yellow {
  background-color: #ffd700;
  border-radius: 30%;
}
div.tvbtn.d {
  font-style: italic;
  background-color: white;
  color: black;
}
div.tvbtn.enter {
  background-color: royalblue;
  border-radius: 10%;
}
div.tvbtn.return {
  background-color: royalblue;
  border-radius: 10%;
}
div.tvbtn.rec {
  background-color: red;
  border-radius: 10%;
}
div.ltbtn {
  display: inline-block;
  width: 4em;
  height: 1.5em;
  text-align: center;
  vertical-align: bottom;
  background-color: navy;
  //padding: auto auto auto auto;
  border: medium solid dimgray;
  border-radius: 20%;
  color: white;
  font-weight: bold;
  font-size: large;
}
</style>
<h1><a href="/remotectrl">Smart Home 2</a></h1>
<h2>Music</h2>
<a href="/radio/status"><div class="ltbtn">Status</div></a>
<pre>Status: <%= stat_msg %></pre><br>
<a href="/music/radio/radio"><div class="ltbtn">Radio</div></a>
<a href="/music/radio/radio0"><div class="ltbtn">Radio0</div></a>
<a href="/music/radio/radio1"><div class="ltbtn">Radio1</div></a>
<a href="/music/radio/radio2"><div class="ltbtn">Radio2</div></a>
<a href="/music/radio/radio3"><div class="ltbtn">Radio3</div></a>
<a href="/music/radio/radio4"><div class="ltbtn">Radio4</div></a>
<a href="/music/radio/radio5"><div class="ltbtn">Radio5</div></a>
<a href="/music/radio/radio6"><div class="ltbtn">Radio6</div></a>
<a href="/music/bluetoothctl/conn"><div class="ltbtn">BT Conn</div></a>
<a href="/music/bluetoothctl/pair"><div class="ltbtn">BT Pair</div></a>
<a href="/bluetooth/restart"><div class="ltbtn">BTsvc restart</div></a>
<a href="/pulseaudio/start"><div class="ltbtn">Pulseaudio start</div></a>
<h2>Soundbar (raspberrypi)</h2>
<a href="/remote/raspberrypi/soundbar/power"><div class="ltbtn">Power</div></a>
<a href="/remote/raspberrypi/soundbar/volup"><div class="ltbtn">VolUp</div></a>
<a href="/remote/raspberrypi/soundbar/voldown"><div class="ltbtn">VolDown</div></a>
<a href="/remote/raspberrypi/soundbar/bluetooth"><div class="ltbtn">Bluetooth</div></a>
<a href="/remote/raspberrypi/soundbar/pairing"><div class="ltbtn">Pairing</div></a>
